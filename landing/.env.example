# ==============================================================================
# Life OS Landing Page — Frontend Environment Variables
# ==============================================================================
# Upstream Reference: https://github.com/zaidazmi/open-waitlist
#
# SECURITY NOTICE:
# - Only variables prefixed with VITE_ are exposed to the browser.
# - NEVER put SUPABASE_SECRET_KEY, RESEND_API_KEY, or any service-role secrets
#   into this file or anywhere in the Vite frontend.
# - Those secrets belong strictly in the standalone open-waitlist backend deployment on Vercel.
# ==============================================================================

# Public URL of your deployed open-waitlist Next.js backend API
# (Leave empty in local development to use automatic simulated mock responses)
VITE_WAITLIST_API_URL=https://life-os-waitlist.vercel.app
